# ---- Required -------------------------------------------------------------
# SQLite for local development. For production use Postgres:
#   1) change `provider` in prisma/schema.prisma to "postgresql"
#   2) DATABASE_URL="postgresql://user:pass@host:5432/interview_connect"
DATABASE_URL="file:./dev.db"

# Public base URL of the app (used for OAuth callbacks and links in emails)
APP_URL="http://localhost:3000"

# ---- AI (question generation, follow-ups, grading) ------------------------
# Without a key the app uses a clearly-labelled rule-based development engine.
ANTHROPIC_API_KEY=""
# Optional override. Default: claude-opus-5
AI_MODEL=""

# ---- Google OAuth (optional) ---------------------------------------------
# Redirect URI to register: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Video (optional) ------------------------------------------------------
# Peer-to-peer WebRTC works out of the box with public STUN. Behind strict
# NATs/firewalls add a TURN server (e.g. Twilio, Cloudflare Calls, coturn).
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ---- Email notifications (optional) ---------------------------------------
# In-app notifications always work. Set these to also send email via Resend.
RESEND_API_KEY=""
EMAIL_FROM="Interview Connect <noreply@example.com>"
