// Interview Connect data model.
//
// SQLite is used for zero-config local development. The schema is portable to
// PostgreSQL (switch `provider`); enum-like columns are stored as strings and
// validated in the service layer (src/lib/constants.ts) so both work.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  /// student | interviewer | admin — only ever set server-side
  role          String    @default("student")
  /// active | suspended | banned
  accountStatus String    @default("active")
  onboardedAt   DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions                Session[]
  oauthAccounts           OAuthAccount[]
  profile                 Profile?
  studentProfile          StudentProfile?
  interviewerProfile      InterviewerProfile?
  resumes                 Resume[]
  jobDescriptions         JobDescription[]
  interviewsAsStudent     Interview[]         @relation("StudentInterviews")
  interviewsAsInterviewer Interview[]         @relation("InterviewerInterviews")
  participations          InterviewSession[]
  availability            Availability[]
  matches                 Match[]
  points                  PointsEntry[]
  badges                  UserBadge[]
  notifications           Notification[]
  conductReports          ConductReport[]     @relation("ReportedUser")
  reportsFiled            ConductReport[]     @relation("ReportFiledBy")
  reportsReviewed         ConductReport[]     @relation("ReportReviewer")
  conductEvents           ConductEvent[]
  technicalEvents         TechnicalEvent[]
  strikes                 Strike[]            @relation("StrikeUser")
  strikesReviewed         Strike[]            @relation("StrikeReviewer")
  appeals                 Appeal[]            @relation("AppealUser")
  appealsReviewed         Appeal[]            @relation("AppealReviewer")
  adminActions            AdminAction[]       @relation("AdminActor")
  adminActionsTarget      AdminAction[]       @relation("AdminTarget")
  interviewerNotes        InterviewerNote[]
  ratingsGiven            InterviewerRating[] @relation("RatingBy")
  ratingsReceived         InterviewerRating[] @relation("RatingFor")
  feedbackGiven           InterviewFeedback[]
  questionRetries         QuestionRetry[]

  @@index([role])
  @@index([accountStatus])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  /// sha256 of the random cookie token — raw tokens are never stored
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Shared public-ish profile data for every role.
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String   @default("")
  location  String?
  timezone  String   @default("America/New_York")
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model StudentProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  school               String?
  major                String?
  graduationYear       Int?
  targetIndustry       String?
  /// JSON string[]
  targetRoles          String    @default("[]")
  /// entry | intern | junior | mid | senior
  experienceLevel      String    @default("entry")
  /// JSON string[]
  companies            String    @default("[]")
  /// JSON string[]: internship | full_time | club | graduate | other
  goals                String    @default("[]")
  /// JSON string[]: behavioral | technical | full
  interviewPreferences String    @default("[]")
  currentStreak        Int       @default(0)
  longestStreak        Int       @default(0)
  lastPracticeDate     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model InterviewerProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  /// student | professional | alumni
  interviewerType String    @default("professional")
  title           String?
  company         String?
  school          String?
  industry        String?
  yearsExperience Int       @default(0)
  /// JSON string[] of role categories (see ROLE_CATEGORIES)
  roles           String    @default("[]")
  /// JSON string[]: behavioral | technical | full
  interviewTypes  String    @default("[\"behavioral\",\"technical\",\"full\"]")
  /// Max interviews per week the interviewer wants
  weeklyLimit     Int       @default(5)
  /// "Available now" toggle for instant human interviews
  availableNow    Boolean   @default(false)
  availableNowAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("interviewer_profiles")
}

// ---------------------------------------------------------------------------
// Interview inputs
// ---------------------------------------------------------------------------

model Resume {
  id          String      @id @default(cuid())
  userId      String
  fileName    String
  mimeType    String
  sizeBytes   Int
  /// Path relative to STORAGE_DIR — files are never publicly served
  storagePath String
  /// Text extracted for AI personalisation (null if parsing unsupported)
  parsedText  String?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews  Interview[]

  @@index([userId])
  @@map("resumes")
}

model JobDescription {
  id         String      @id @default(cuid())
  userId     String
  title      String?
  company    String?
  content    String
  source     String      @default("paste") // paste | upload
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([userId])
  @@map("job_descriptions")
}

// ---------------------------------------------------------------------------
// Interviews
// ---------------------------------------------------------------------------

model Interview {
  id                    String    @id @default(cuid())
  studentId             String
  interviewerId         String?
  /// ai | human
  mode                  String
  /// behavioral | technical | full
  type                  String
  targetRole            String
  /// Role category used for question banks + matching (see ROLE_CATEGORIES)
  roleCategory          String    @default("general")
  company               String?
  jobDescriptionId      String?
  resumeId              String?
  /// beginner | intermediate | advanced
  difficulty            String    @default("intermediate")
  /// minutes: 15 | 30 | 45 | 60
  duration              Int       @default(30)
  /// student | professional | anyone (human mode)
  interviewerPreference String    @default("anyone")
  /// scheduled | waiting | active | completed | cancelled | no_show | reported
  status                String    @default("scheduled")
  /// unmatched | pending | matched (human mode)
  matchStatus           String    @default("unmatched")
  /// pending | processing | completed | failed
  gradingStatus         String    @default("pending")
  /// not_started | generating | ready | failed
  questionStatus        String    @default("not_started")
  /// ai | fallback — which engine produced the questions
  questionEngine        String?
  overallScore          Int?
  /// Human-readable reason when grading could not complete
  gradingError          String?
  /// Index of the question currently being asked (0-based, -1 = intro)
  currentQuestionIndex  Int       @default(-1)
  /// The question (main or follow-up) currently awaiting an answer
  activeQuestionId      String?
  /// JSON string[] of user ids recorded as no-shows (never a strike)
  noShowUserIds         String    @default("[]")
  /// Whether the current question has an outstanding AI/interviewer follow-up
  followUpCount         Int       @default(0)
  pausedAt              DateTime?
  scheduledAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  recordingConsent      Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  student          User                @relation("StudentInterviews", fields: [studentId], references: [id], onDelete: Cascade)
  interviewer      User?               @relation("InterviewerInterviews", fields: [interviewerId], references: [id], onDelete: SetNull)
  jobDescription   JobDescription?     @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  resume           Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  questions        InterviewQuestion[]
  answers          InterviewAnswer[]
  sessions         InterviewSession[]
  transcript       TranscriptEntry[]
  feedback         InterviewFeedback?
  evaluation       AiEvaluation?
  notes            InterviewerNote[]
  rating           InterviewerRating?
  matches          Match[]
  availabilitySlot Availability?
  conductReports   ConductReport[]
  conductEvents    ConductEvent[]
  technicalEvents  TechnicalEvent[]
  strikes          Strike[]
  signals          RtcSignal[]
  retries          QuestionRetry[]

  @@index([studentId, status])
  @@index([interviewerId, status])
  @@index([status, scheduledAt])
  @@index([mode, matchStatus])
  @@map("interviews")
}

/// AI-generated question plan. Hidden fields (whatItTests, gradingCriteria…)
/// are never sent to the candidate.
model InterviewQuestion {
  id               String            @id @default(cuid())
  interviewId      String
  order            Int
  /// intro | behavioral | technical | role | coding | case | closing | candidate_questions
  category         String
  text             String
  difficulty       String
  whatItTests      String
  /// JSON string[]
  competencies     String            @default("[]")
  /// JSON string[]
  followUps        String            @default("[]")
  /// JSON string[]
  gradingCriteria  String            @default("[]")
  /// JSON string[] — key concepts a strong answer covers (grader only)
  keywords         String            @default("[]")
  /// Follow-up questions generated live (AI or interviewer), not in original plan
  isFollowUp       Boolean           @default(false)
  parentQuestionId String?
  askedAt          DateTime?
  createdAt        DateTime          @default(now())
  interview        Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  answers          InterviewAnswer[]
  retries          QuestionRetry[]

  @@index([interviewId, order])
  @@map("interview_questions")
}

model InterviewAnswer {
  id          String            @id @default(cuid())
  interviewId String
  questionId  String
  text        String
  /// speech | typed
  source      String            @default("typed")
  durationSec Int?
  createdAt   DateTime          @default(now())
  interview   Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question    InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([questionId])
  @@map("interview_answers")
}

/// Per-participant presence in the room (lobby readiness, joins, heartbeats).
model InterviewSession {
  id              String    @id @default(cuid())
  interviewId     String
  userId          String
  /// candidate | interviewer
  participantRole String
  ready           Boolean   @default(false)
  joinedAt        DateTime?
  leftAt          DateTime?
  lastSeenAt      DateTime?
  /// connected | reconnecting | disconnected
  connectionState String    @default("disconnected")
  deviceCheck     String? // JSON: {camera, mic, network}
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@map("interview_sessions")
}

/// The interview transcript: every question asked and every answer captured.
model TranscriptEntry {
  id          String    @id @default(cuid())
  interviewId String
  /// interviewer | candidate | system
  speaker     String
  /// question | follow_up | answer | intro | closing | note
  kind        String
  text        String
  questionId  String?
  /// speech (browser speech-to-text) | typed | ai | guide
  source      String    @default("typed")
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
  @@map("interview_transcripts")
}

/// Optional qualitative feedback from a human interviewer (not the official score).
model InterviewFeedback {
  id            String    @id @default(cuid())
  interviewId   String    @unique
  interviewerId String
  strengths     String?
  improvements  String?
  notes         String?
  createdAt     DateTime  @default(now())
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer   User      @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@map("interview_feedback")
}

/// The official, standardized AI evaluation. Only the grading service writes it.
model AiEvaluation {
  id                         String    @id @default(cuid())
  interviewId                String    @unique
  /// ai | fallback
  engine                     String
  model                      String?
  overallScore               Int
  communication              Int?
  confidence                 Int?
  answerStructure            Int?
  technicalKnowledge         Int?
  problemSolving             Int?
  roleKnowledge              Int?
  professionalism            Int?
  behavioral                 Int?
  summary                    String
  /// JSON string[]
  strengths                  String    @default("[]")
  /// JSON string[]
  improvements               String    @default("[]")
  /// JSON: [{questionId, question, answerExcerpt, score, feedback, star?}]
  questionFeedback           String    @default("[]")
  recommendation             String
  interviewerFeedbackSummary String?
  createdAt                  DateTime  @default(now())
  interview                  Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("ai_evaluations")
}

model InterviewerNote {
  id            String    @id @default(cuid())
  interviewId   String
  interviewerId String
  questionId    String?
  text          String
  createdAt     DateTime  @default(now())
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer   User      @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@map("interviewer_notes")
}

/// Student's rating of their human interviewer. Never affects candidate score.
model InterviewerRating {
  id               String    @id @default(cuid())
  interviewId      String    @unique
  studentId        String
  interviewerId    String
  professionalism  Int
  realism          Int
  communication    Int
  feedbackQuality  Int
  comment          String?
  /// visible | hidden (admin moderation)
  moderationStatus String    @default("visible")
  createdAt        DateTime  @default(now())
  interview        Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  student          User      @relation("RatingBy", fields: [studentId], references: [id], onDelete: Cascade)
  interviewer      User      @relation("RatingFor", fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([interviewerId])
  @@map("interviewer_ratings")
}

// ---------------------------------------------------------------------------
// Matching + scheduling
// ---------------------------------------------------------------------------

model Match {
  id            String    @id @default(cuid())
  interviewId   String
  interviewerId String
  score         Float
  /// pending | accepted | declined | expired | cancelled
  status        String    @default("pending")
  /// JSON string[] of human-readable match reasons
  reasons       String    @default("[]")
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer   User      @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([interviewerId, status])
  @@index([interviewId])
  @@map("matches")
}

/// Bookable slot offered by an interviewer. Unique interviewId prevents double booking.
model Availability {
  id            String     @id @default(cuid())
  interviewerId String
  startsAt      DateTime
  endsAt        DateTime
  timezone      String
  interviewId   String?    @unique
  createdAt     DateTime   @default(now())
  interviewer   User       @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  interview     Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([interviewerId, startsAt])
  @@index([startsAt])
  @@map("availability")
}

/// WebRTC signaling messages (offer/answer/ICE) relayed through the API.
model RtcSignal {
  id          String    @id @default(cuid())
  interviewId String
  fromUserId  String
  toUserId    String
  kind        String
  payload     String
  consumed    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, toUserId, consumed])
  @@map("rtc_signals")
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

/// Points ledger — the total is always the sum of entries.
model PointsEntry {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  reason      String
  interviewId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("points")
}

model Badge {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String
  icon        String
  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Conduct
// ---------------------------------------------------------------------------

/// Potential conduct signal (inactivity, left room, warning issued). Never a strike.
model ConductEvent {
  id          String     @id @default(cuid())
  userId      String
  interviewId String?
  /// inactivity | tab_hidden | left_early | no_response | warning_issued | warning_acknowledged
  type        String
  /// system | interviewer
  source      String     @default("system")
  details     String?
  resolved    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview   Interview? @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([interviewId])
  @@map("conduct_events")
}

/// Technical problems — logged separately and never counted as misconduct.
model TechnicalEvent {
  id          String     @id @default(cuid())
  userId      String
  interviewId String?
  /// connection_lost | reconnected | camera_error | mic_error | media_denied | ice_failed
  type        String
  details     String?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview   Interview? @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([userId])
  @@map("technical_events")
}

model ConductReport {
  id           String     @id @default(cuid())
  userId       String
  interviewId  String?
  reportedById String?
  /// left_interview | inactivity | refused | disrespectful | disruptive | platform_abuse | other
  reason       String
  description  String
  /// JSON evidence (conduct events, timestamps, transcript excerpt ids)
  evidence     String     @default("{}")
  /// interviewer | system | admin
  source       String     @default("interviewer")
  /// pending | confirmed | dismissed | appealed | overturned
  status       String     @default("pending")
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime   @default(now())
  user         User       @relation("ReportedUser", fields: [userId], references: [id], onDelete: Cascade)
  interview    Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  reportedBy   User?      @relation("ReportFiledBy", fields: [reportedById], references: [id], onDelete: SetNull)
  reviewedBy   User?      @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  strike       Strike?

  @@index([status, createdAt])
  @@index([userId])
  @@map("conduct_reports")
}

model Strike {
  id           String         @id @default(cuid())
  userId       String
  /// 1, 2 or 3 at the time it was issued
  strikeNumber Int
  interviewId  String?
  reportId     String?        @unique
  reason       String
  description  String
  evidence     String         @default("{}")
  reviewerId   String?
  /// active | overturned | removed
  status       String         @default("active")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation("StrikeUser", fields: [userId], references: [id], onDelete: Cascade)
  interview    Interview?     @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  report       ConductReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reviewer     User?          @relation("StrikeReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  appeals      Appeal[]

  @@index([userId, status])
  @@map("strikes")
}

model Appeal {
  id           String    @id @default(cuid())
  strikeId     String
  userId       String
  reason       String
  description  String
  /// pending | approved | denied
  status       String    @default("pending")
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  submittedAt  DateTime  @default(now())
  strike       Strike    @relation(fields: [strikeId], references: [id], onDelete: Cascade)
  user         User      @relation("AppealUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("AppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("appeals")
}

/// Immutable audit log of every administrative action.
model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String?
  action       String
  details      String?
  createdAt    DateTime @default(now())
  admin        User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_actions")
}

/// Product analytics. Stores event names + ids only — no free-text PII.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  userId     String?
  properties String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@map("analytics_events")
}

/// Fixed-window rate limiting buckets.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@map("rate_limits")
}

/// "Practice this question again": a new attempt at one question from a graded
/// interview, scored on the same rubric and compared with the original answer.
model QuestionRetry {
  id            String            @id @default(cuid())
  userId        String
  interviewId   String
  questionId    String
  answer        String
  /// speech | typed
  source        String            @default("typed")
  durationSec   Int?
  score         Int
  /// Score of the original answer when the retry was made (for the comparison)
  originalScore Int?
  feedback      String
  /// JSON string[]: what got better vs the original answer
  improved      String            @default("[]")
  /// JSON string[]: what to work on next
  nextSteps     String            @default("[]")
  /// JSON {situation,task,action,result} for behavioral questions
  star          String?
  /// ai | fallback
  engine        String
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview     Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question      InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([interviewId, questionId])
  @@map("question_retries")
}
